# Copy to .env and fill in real values. Never commit .env.
# This file is the template — keep it placeholder-only, real secrets go in
# .env (gitignored), never here.
SUPABASE_URL=https://njimpjauiocgzwqsgehg.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for direct psql/CLI db access, not for app code:
SUPABASE_DB_PASSWORD=

# YouTube Data API v3 (publishing — Phase 6). Google Cloud project + OAuth
# consent screen (Testing mode to start). See plan §4 for the refresh-token
# caveat on unverified apps.
# YOUTUBE_API_KEY is read-only (search/public metadata) — it cannot upload
# or act on a channel. Actual publishing needs the OAuth trio below too.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API (publishing — Phase 6). Unaudited apps are
# restricted to private/self-only visibility until review passes.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta / Instagram Graph API (publishing — Phase 6). Requires a Business or
# Creator Instagram account linked to a Facebook Page.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Apify (campaign discovery — see worker/src/jobs/discover-campaigns.ts —
# and trend research, Phase 7+, throttled/optional, see plan §5 cost table)
APIFY_TOKEN=
# Whop Content Rewards scraper actor, "username~actorName" form. Defaults to
# fayoussef~whop-clipping-campaigns-scraper (confirmed working against live
# data) if unset.
APIFY_WHOP_ACTOR_ID=

# LLM provider for hook/caption/virality generation (Phase 3+)
ANTHROPIC_API_KEY=

# Google Drive API (campaign source content delivered via "anyone with the
# link" Drive files/folders — see worker/src/lib/drive.ts). Enable the Drive
# API on a Google Cloud project and create an API key; no OAuth needed since
# these files are publicly link-shared.
GOOGLE_DRIVE_API_KEY=
