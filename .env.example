# Copy to .env and fill in real values. Never commit .env.
# This file is the template — keep it placeholder-only, real secrets go in
# .env (gitignored), never here.
SUPABASE_URL=https://njimpjauiocgzwqsgehg.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for direct psql/CLI db access, not for app code:
SUPABASE_DB_PASSWORD=

# YouTube Data API v3 (publishing — Phase 6). Google Cloud project + OAuth
# consent screen (Testing mode to start). See plan §4 for the refresh-token
# caveat on unverified apps.
# YOUTUBE_API_KEY is read-only (search/public metadata) — it cannot upload
# or act on a channel. Actual publishing needs the OAuth trio below too.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional — path to a Netscape-format cookies.txt exported from a real,
# logged-in YouTube session (e.g. via the "Get cookies.txt LOCALLY"
# browser extension). Passed to yt-dlp (see worker/src/lib/ytdlp.ts) to
# reduce YouTube's bot-detection blocking on datacenter IPs — this is
# what actually broke a real GitHub Actions run ("Sign in to confirm
# you're not a bot" on every clip download). Not usually needed for
# local dev from a home connection.
YOUTUBE_COOKIES_PATH=

# TikTok Content Posting API — video.upload scope, inbox/draft upload
# only (see worker/src/lib/tiktok.ts). Not the audited Direct Post path;
# uploads land as a draft in the account's own TikTok inbox for manual
# posting. TIKTOK_REFRESH_TOKEN comes from running
# `npm run tiktok-oauth-bootstrap` once — note TikTok can rotate this
# value on every use, so it may need updating after each run of
# tiktok-upload-test.ts / a future publish-tiktok.ts.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Instagram Platform API (Business Login for Instagram) — publishing as
# Reels. Requires a Business/Creator Instagram account linked to a
# Facebook Page (see worker/src/lib/meta.ts). META_ACCESS_TOKEN and
# META_INSTAGRAM_USER_ID come from running
# `npm run instagram-oauth-bootstrap` once — a long-lived token, good
# for 60 days; lib/meta.ts's refreshLongLivedToken() extends it another
# 60 days once it's at least 24h old, for a future scheduled refresh job.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=

# Last.fm API (free, instant key, no OAuth) for the automated
# "top 5 by real playcount" ranking source. Spotify's own top-tracks
# endpoint is deprecated/gated behind an approval process a normal app
# doesn't get — see worker/src/lib/lastfm.ts. Get a key at
# last.fm/api/account/create.
LASTFM_API_KEY=

# Google Sheets API (personal-picks ranking source — a Google Form whose
# responses land in this sheet; see worker/src/lib/googleSheets.ts and
# jobs/sync-personal-rankings.ts for the exact form question layout).
# Enable the Sheets API on a Google Cloud project (can be the same project
# as YOUTUBE_API_KEY) and create an API key; the target sheet must be
# shared "anyone with the link can view" since this reads without OAuth.
GOOGLE_SHEETS_API_KEY=
PERSONAL_RANKINGS_SHEET_ID=
# Optional — defaults to "Form Responses 1!A:Z" (Google Forms' default
# tab name when linked to an existing spreadsheet). Override only if you
# rename that tab.
PERSONAL_RANKINGS_SHEET_RANGE=

# Anthropic (dynamic per-artist bio generation, cached in artists.bio —
# see worker/src/lib/anthropic.ts).
ANTHROPIC_API_KEY=

# ElevenLabs (single spoken intro hook line per video — see
# worker/src/lib/elevenlabs.ts and jobs/generate-intro-vo.ts. Not used for
# per-song narration; that was tried and reverted).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
